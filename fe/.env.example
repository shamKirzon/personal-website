# Upstash Redis — backs the shared visitor list on the Visitors tab.
# Create a free database at https://upstash.com, then copy its REST
# credentials here and into the Vercel project's environment variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Existing backend (contact form + chatbot), hosted separately on Render.
VITE_RENDER_API_KEY=

# Dev-only: /api/visitors has no real city to resolve under `vercel dev`
# (Vercel's geo headers only exist on the deployed edge network). Set these
# so testing through the actual UI works locally. Ignored in production
# regardless of value.
DEV_FALLBACK_CITY=Taguig
DEV_FALLBACK_COUNTRY=PH
DEV_FALLBACK_LAT=14.5176
DEV_FALLBACK_LNG=121.0509
